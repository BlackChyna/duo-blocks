# DUO BLOCKS environment configuration
# Copy this file to .env and fill in your Supabase project values.
# NEVER commit the real .env file.

# Supabase project URL — find it in Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable (anon) key — safe to expose in the frontend because all data is
# protected by Row Level Security. NEVER put the service_role key in the app.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
